# Local development settings. Copy this file to .env to customize them.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Render only: exact public hostname without scheme, path or port.
# RENDER_DEPLOYMENT=true
# PUBLIC_HOST=your-service.onrender.com
# DATABASE_URL must include sslmode=require (or verify-full) on Render.

# Required demo authentication. Generate locally; never use shared defaults.
# See docs/demo-authentication.md for hidden password input and secret generation.
DEMO_USERNAME=
DEMO_PASSWORD_HASH=
SECRET_KEY=
# false ONLY for local HTTP. Use true whenever HTTPS serves the application.
SESSION_COOKIE_SECURE=false

# Backend only. Obtain a key at https://aistudio.google.com/apikey.
# Confirm the project's Free tier and this model's available quota in AI Studio
# before making live requests. Never enable billing to run this demonstration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Integer seconds, 1-60; output tokens, 128-2048. No automatic retries/fallback.
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1024

# Private PDF storage; relative paths are resolved against backend/, not the shell.
# Default: backend/instance/document_uploads. Never use frontend/public or static/.
DOCUMENT_UPLOAD_DIR=instance/document_uploads

# Local is the development default. Supabase never falls back to local storage.
PDF_STORAGE_BACKEND=local
# For supabase mode only: private hosted project origin, server secret, bucket ID.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# Required for normal startup. Replace placeholders with your local settings.
# Separate fields accept literal passwords without URL encoding.
# Quote passwords containing spaces or # according to dotenv syntax.
DB_HOST=localhost
DB_PORT=7498
DB_USER=postgres
DB_PASSWORD='YOUR_LITERAL_PASSWORD'
DB_NAME=healthcareassist_ai

# Optional alternative: a nonempty DATABASE_URL takes precedence over DB_*.
# Discover your PostgreSQL port; do not assume it is 5432.
# URL-encode special characters in the username and password.
# postgresql:// URLs are also accepted and select psycopg 3 automatically.
# DATABASE_URL=postgresql+psycopg://YOUR_ROLE:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:YOUR_PORT/healthcareassist_ai
